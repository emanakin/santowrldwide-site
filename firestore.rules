rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - allow users to read/write their own data only
    match /users/{userId} {
      // Allow authenticated users to read/write their own user document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to create their own user document during signup
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Newsletter subscribers and rate limits are handled server-side with Admin SDK
    // Admin SDK bypasses these security rules entirely, so no rules needed
    
    // shoots, model_applications and models are written only by the Admin SDK
    // via the /api/models and /api/admin routes, so they stay denied below
    
    // Global rule: Deny all other access by default
    // This ensures security for any collections not explicitly defined above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}